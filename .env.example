# ─── App Settings ───
APP_NAME=Smart Guardian Epilepsy AI
APP_DESCRIPTION=Epilepsy monitoring and seizure detection backend
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8001

# ─── Database ───
DATABASE_URL=postgresql://sgadmin:sgpass123@db:5432/smartguardian
POSTGRES_DB=smartguardian
POSTGRES_USER=sgadmin
POSTGRES_PASSWORD=sgpass123

# ─── JWT ───
JWT_SECRET_KEY=change-me-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ─── MQTT ───
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_TOPIC_PREFIX=smart-guardian

# ─── AI / ML ───
AI_MODEL_PATH=models/seizure_detector.h5
AI_SEIZURE_THRESHOLD=0.5
AI_CONFIDENCE_THRESHOLD=0.85

# ─── Logging ───
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

MQTT_TOPIC_SENSORS=smart-guardian/sensors
MQTT_TOPIC_ALERTS=smart-guardian/alerts
MODEL_VERSION=1.0.0
SEIZURE_THRESHOLD=0.5
MODEL_PATH=models/seizure_detector.h5
